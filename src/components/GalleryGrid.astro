---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Ordered photos, straight from the gallery frontmatter. */
  photos: { src: ImageMetadata; alt: string; title?: string }[];
}

const { photos } = Astro.props;

// Column-masonry layout: every tile keeps its photo's own aspect ratio, so
// portrait and landscape frames sit together with no crop and no distortion.
// Each `<a>` reserves its space via `aspect-ratio` before the image loads, so
// the grid does not shift as thumbnails come in.
//
// The first row loads eagerly; everything further down lazy-loads. The anchor
// points at a larger rendition and carries the `data-pswp-*` dimensions the
// fullscreen viewer (#11) reads to open PhotoSwipe at that photo. With JS off
// the anchor still degrades to opening the image directly.
const EAGER_COUNT = 3;
const tiles = await Promise.all(
  photos.map(async (photo, index) => {
    const width = Math.min(photo.src.width, 2400);
    const height = Math.round((photo.src.height / photo.src.width) * width);
    const full = await getImage({ src: photo.src, width, format: 'webp' });
    return { photo, index, full, width, height };
  }),
);
---

<ul class="gallery-grid mt-3 columns-1 gap-2 sm:columns-2 lg:columns-3 lg:gap-3">
  {
    tiles.map(({ photo, index, full, width, height }) => (
      <li class="mb-2 break-inside-avoid lg:mb-3">
        <a
          href={full.src}
          data-pswp-width={width}
          data-pswp-height={height}
          title={photo.title}
          class="group block overflow-hidden bg-line"
          style={`aspect-ratio: ${photo.src.width} / ${photo.src.height}`}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading={index < EAGER_COUNT ? 'eager' : 'lazy'}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </a>
      </li>
    ))
  }
</ul>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  // #11 — open/close the fullscreen viewer. PhotoSwipe gives us most of the
  // acceptance criteria out of the box: close button, Esc, click outside the
  // image, and returning focus to the thumbnail that opened it (`returnFocus`,
  // on by default).
  //
  // #12 — prev/next navigation. Also PhotoSwipe out of the box: the
  // arrowPrev/arrowNext buttons (visible on hover, toggled by tap on touch) and
  // the ArrowLeft/ArrowRight keys. The two options below are the deliberate
  // choices the story asks for, set explicitly so the intent is on the page:
  //   - `loop` — wrap at the first/last photo rather than disabling the arrows.
  //     The story is "browse the full set fluidly"; wrapping keeps that going.
  //   - `preload` — fetch the full-res image one slide back and two ahead of the
  //     current one, so the next/prev photo is decoded before it is shown and
  //     there is no pop-in. (This is also PhotoSwipe's default; pinned here so a
  //     future default change can't silently regress the criterion.)
  //
  // #14 — thumbnail strip. PhotoSwipe has no filmstrip of its own, so we build
  // one as a custom UI element (see `uiRegister` below) from the same grid
  // anchors that drive the slides — strip index === slide index. `paddingFn`
  // reserves a band at the bottom of the viewport on wide screens so the image
  // never sits under the strip; on narrow viewports (< 640px) the strip is
  // hidden (CSS) and the padding drops to 0 — the decision on the story's open
  // question: a strip there would crowd the photo more than it helps.
  //
  // #16 — zoom. PhotoSwipe covers the whole story out of the box: click /
  // double-click (desktop), double-tap / pinch (mobile) and the zoom button all
  // toggle zoom, drag/touch pans the zoomed image, and zoom level is per-slide
  // so it resets on prev/next. The two options below are the deliberate choices,
  // pinned so the intent is on the page (and a future default change can't
  // silently regress it):
  //   - `initialZoomLevel: 'fit'` — open showing the whole frame.
  //   - `secondaryZoomLevel: 'fill'` — click / double-tap / zoom-button zoom the
  //     photo to fill the viewport. Pinch and ctrl/trackpad zoom still run up to
  //     PhotoSwipe's 4×-of-fit ceiling for pixel-level detail.
  const STRIP_BAND = 84;
  const stripVisible = () => window.matchMedia('(min-width: 640px)').matches;

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.gallery-grid',
    children: 'a',
    pswpModule: () => import('photoswipe'),
    loop: true,
    preload: [1, 2],
    initialZoomLevel: 'fit',
    secondaryZoomLevel: 'fill',
    paddingFn: () => ({
      top: 0,
      bottom: stripVisible() ? STRIP_BAND : 0,
      left: 0,
      right: 0,
    }),
  });

  // Build the thumbnail strip once PhotoSwipe registers its UI.
  lightbox.on('uiRegister', () => {
    const pswp = lightbox.pswp;
    if (!pswp) return;

    const anchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('.gallery-grid li a'));

    pswp.ui?.registerElement({
      name: 'thumbstrip',
      appendTo: 'wrapper',
      onInit: (el) => {
        el.className = 'pswp__thumbstrip';
        el.setAttribute('role', 'tablist');
        el.setAttribute('aria-label', 'Gallery photos');

        // Strip interactions must not reach PhotoSwipe's tap handler on the
        // scroll wrap, or clicking a thumbnail would also close the viewer.
        for (const evt of ['pointerdown', 'pointerup', 'click', 'mousedown']) {
          el.addEventListener(evt, (e) => e.stopPropagation());
        }

        const buttons = anchors.map((a, i) => {
          const source = a.querySelector('img');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'pswp__thumbstrip-item';
          btn.setAttribute('role', 'tab');
          btn.setAttribute(
            'aria-label',
            source?.alt ? `Photo ${i + 1}: ${source.alt}` : `Photo ${i + 1}`,
          );

          const img = document.createElement('img');
          if (source?.srcset) img.srcset = source.srcset;
          img.src = source?.currentSrc || source?.src || a.href;
          img.sizes = '80px';
          img.alt = '';
          img.loading = 'lazy';
          img.decoding = 'async';
          btn.append(img);

          btn.addEventListener('click', () => pswp.goTo(i));
          el.append(btn);
          return btn;
        });

        const sync = () => {
          buttons.forEach((btn, i) => {
            const active = i === pswp.currIndex;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-selected', active ? 'true' : 'false');
            btn.tabIndex = active ? 0 : -1;
            if (active) {
              btn.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
            }
          });
        };

        pswp.on('change', sync);
        sync();
      },
    });
  });

  // Lock background page scroll for the whole time the viewer is open.
  // PhotoSwipe only swallows wheel events over its own overlay; this also stops
  // keyboard and scrollbar scrolling of the page behind it.
  const root = document.documentElement;
  lightbox.on('beforeOpen', () => {
    root.style.overflow = 'hidden';
  });
  lightbox.on('destroy', () => {
    root.style.overflow = '';
  });

  // #17 — keyboard navigation. PhotoSwipe already gives us arrow keys, Esc, and
  // labelled controls. What it does not do well: its focus trap only bounces
  // stray focus back to the dialog root (it never wraps Tab), and on a pointer
  // open it never moves focus into the dialog at all. Three pieces below make it
  // watertight — `inert` on the rest of the page, a Tab-wrapping handler, and an
  // explicit focus hand-back to the opening thumbnail on close.

  // 1. Everything outside `.pswp` goes `inert` while the viewer is open, so
  //    nothing behind the overlay is focusable or reachable by Tab.
  const pageRegions = () =>
    Array.from(document.body.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement && !el.classList.contains('pswp'),
    );
  lightbox.on('bindEvents', () => {
    for (const el of pageRegions()) el.inert = true;
  });
  lightbox.on('close', () => {
    for (const el of pageRegions()) el.inert = false;
  });

  // 2. Return focus to the thumbnail that opened the viewer. PhotoSwipe's own
  //    `returnFocus` only fires for keyboard-opened dialogs, and `inert` has
  //    since moved focus off the opener anyway. Capture the anchor from the
  //    activating click (fired for Enter/Space too); restore it after teardown,
  //    deferred a frame so it lands after any focus move PhotoSwipe makes.
  let opener: HTMLElement | null = null;
  document.querySelector('.gallery-grid')?.addEventListener(
    'click',
    (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('.gallery-grid a');
      if (a) opener = a;
    },
    true,
  );
  lightbox.on('destroy', () => {
    const target = opener;
    if (target) requestAnimationFrame(() => target.focus());
  });

  // 3. Wrap Tab / Shift+Tab between the first and last visible control inside
  //    `.pswp`. A document-level capture handler so it also catches the case
  //    where focus is sitting on <body> (pointer open, everything else inert).
  const onTabKey = (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    const pswpEl = lightbox.pswp?.element;
    if (!pswpEl) return;

    const focusable = Array.from(
      pswpEl.querySelectorAll<HTMLElement>('button, a[href], [tabindex]:not([tabindex="-1"])'),
    ).filter((el) => el.offsetParent !== null && !(el as HTMLButtonElement).disabled);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const active = document.activeElement;
    // Anything that is not one of our controls — the dialog root, or <body>
    // after an inert opener lost focus — counts as "off the loop" and gets
    // pulled back to an end.
    const onControl = active instanceof HTMLElement && focusable.includes(active);

    if (e.shiftKey && (!onControl || active === first)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && (!onControl || active === last)) {
      e.preventDefault();
      first.focus();
    }
  };
  lightbox.on('bindEvents', () => document.addEventListener('keydown', onTabKey, true));
  lightbox.on('destroy', () => document.removeEventListener('keydown', onTabKey, true));

  lightbox.init();

  // Mark the grid once the click handler is live, so progressive enhancement is
  // observable (the anchors still open the image directly until this point).
  document.querySelector('.gallery-grid')?.setAttribute('data-pswp-ready', '');
</script>

<!--
  #14 — thumbnail strip styling. Global because PhotoSwipe mounts `.pswp` on
  <body>, out of this component's scoped-style reach. Hidden below 640px (see
  `paddingFn` in the script — the two breakpoints must agree).
-->
<style is:global>
  .pswp__thumbstrip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1500;
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    overflow-x: auto;
    overscroll-behavior: contain;
    background: rgba(0, 0, 0, 0.45);
    scrollbar-width: thin;
  }

  .pswp__thumbstrip-item {
    flex: 0 0 auto;
    width: 5rem;
    height: 3.5rem;
    padding: 0;
    border: 2px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.5;
    transition:
      opacity 0.15s ease,
      border-color 0.15s ease;
  }

  .pswp__thumbstrip-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pswp__thumbstrip-item:hover,
  .pswp__thumbstrip-item:focus-visible {
    opacity: 0.85;
  }

  .pswp__thumbstrip-item.is-active {
    opacity: 1;
    border-color: #fff;
  }

  /*
    #17 — keyboard focus indicator. The site-wide :focus-visible ring in
    global.css is near-black (--color-ink) and vanishes against PhotoSwipe's
    dark overlay, so every control inside the viewer gets a light ring instead.
  */
  .pswp .pswp__button:focus-visible,
  .pswp__thumbstrip-item:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    opacity: 1;
  }

  @media (max-width: 639px) {
    .pswp__thumbstrip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pswp__thumbstrip-item {
      transition: none;
    }
  }
</style>
