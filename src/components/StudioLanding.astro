---
/**
 * The home page, in one locale — a short intro and a taster of the galleries.
 *
 * Rendered by `src/pages/index.astro` (es) and `src/pages/en/index.astro` (en);
 * the only difference between them is the `lang` prop. The full galleries list
 * is its own page (`GalleryIndex`, `/galleries`); what a session is lives on
 * `/the-session` (`SessionInfo`).
 *
 * Copy lives in `src/i18n/ui.ts`. Gallery titles/descriptions come from the
 * content collection via `localizedGallery`.
 */
import { Picture } from 'astro:assets';
import { localizePath, t } from '../i18n/utils';
import { getGalleries, galleryHref, localizedGallery } from '../lib/galleries';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);

const galleriesPath = localizePath('/galleries', lang);
const contactPath = localizePath('/contact', lang);

// The galleries grid — filtered + sorted (drafts show in `astro dev` only).
const galleries = await getGalleries();
---

<article>
  {/* ---- Hero ---- */}
  <section class="max-w-3xl pt-4 md:pt-10">
    <h1 class="font-serif text-4xl leading-tight md:text-6xl">{c.home.hero.motto}</h1>
    <p class="mt-6 font-serif text-2xl leading-snug text-ink md:text-3xl">{c.home.hero.lead}</p>
    <p class="mt-5 text-base text-muted">{c.home.hero.note}</p>
    <a
      href={contactPath}
      class="mt-8 inline-flex items-center rounded-full bg-ink px-6 py-3 text-sm text-canvas transition-colors hover:bg-muted"
    >
      {c.cta.book}
    </a>
  </section>

  {/* ---- Galleries ---- */}
  <section id="galleries" class="mt-24 scroll-mt-24 md:mt-32">
    <h2 class="text-2xl md:text-3xl">
      <a href={galleriesPath} class="hover:text-muted">{c.galleries.title}</a>
    </h2>
    <p class="mt-3 max-w-2xl text-sm text-muted">{c.galleries.lead}</p>
    {
      galleries.length === 0 ? (
        <p class="mt-10 text-muted">{c.galleries.empty}</p>
      ) : (
        <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {galleries.map((gallery, index) => {
            const localized = localizedGallery(gallery, lang);
            return (
              <li>
                <article>
                  <a href={localizePath(galleryHref(gallery), lang)} class="group block">
                    <div class="overflow-hidden bg-line">
                      <Picture
                        src={gallery.data.cover}
                        alt=""
                        formats={['avif', 'webp']}
                        width={480}
                        height={320}
                        densities={[1, 2]}
                        loading={index < 4 ? 'eager' : 'lazy'}
                        class="aspect-3/2 w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      />
                    </div>
                    <h3 class="mt-4 text-xl group-hover:text-muted">{localized.title}</h3>
                    <p class="mt-1 text-sm text-muted">{localized.description}</p>
                    <p class="mt-2 text-xs text-muted">
                      {c.galleries.photos(gallery.data.photos.length)}
                    </p>
                  </a>
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</article>
