---
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGalleries, gallerySlug } from '../../lib/galleries';

// Detail page: a cover hero plus the responsive thumbnail grid (#8). The full
// metadata block (#10) builds on top of this.
export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallerySlug(gallery) },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

const { gallery } = Astro.props;
const { title, description, date, cover, photos } = gallery.data;
const captured = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout title={title} description={description}>
  <section class="max-w-2xl">
    <p class="text-sm text-muted"><a href="/" class="hover:text-ink">← Galleries</a></p>
    <h1 class="mt-4 text-3xl md:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-muted">{description}</p>
    <p class="mt-2 text-xs text-muted">{captured}</p>
  </section>

  <div class="mt-10 overflow-hidden bg-line">
    <Image src={cover} alt="" width={1280} height={853} class="aspect-3/2 w-full object-cover" />
  </div>

  <h2 class="mt-12 text-sm text-muted">{photos.length} photos</h2>
  <GalleryGrid photos={photos} />
</BaseLayout>
