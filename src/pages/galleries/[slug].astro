---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGalleries, gallerySlug } from '../../lib/galleries';

// Detail page: the metadata block (#10) sitting above the responsive thumbnail
// grid (#8). No cover hero — the grid leads.
export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallerySlug(gallery) },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

const { gallery } = Astro.props;
const { title, description, date, location, tags, photos } = gallery.data;
const captured = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
});
const isoDate = date.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <section class="max-w-2xl">
    <p class="text-sm text-muted"><a href="/" class="hover:text-ink">← Galleries</a></p>
    <h1 class="mt-4 text-3xl md:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-muted">{description}</p>
    <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted">
      <div>
        <dt class="sr-only">Date</dt>
        <dd><time datetime={isoDate}>{captured}</time></dd>
      </div>
      {
        location && (
          <div>
            <dt class="sr-only">Location</dt>
            <dd>{location}</dd>
          </div>
        )
      }
      {
        tags && (
          <div>
            <dt class="sr-only">Tags</dt>
            <dd>
              <ul class="flex flex-wrap gap-x-3">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <h2 class="mt-8 text-sm text-muted">{photos.length} photos</h2>
  <GalleryGrid photos={photos} />
</BaseLayout>
